    <DataTemplate DataType="{x:Type vm:BlackHoleCustomInfoFactoryViewModel}">
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Magnitude"/>
            <TextBox Text="{Binding Magnitude, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,5,0,0" Content="Radius"/>
            <TextBox Text="{Binding Radius, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,5,0,0" Content="Vortex effect name"/>
            <ComboBox Margin="0,0,0,0" ItemsSource="{x:Static local:AppSettings.Effects}" SelectedItem="{Binding VortexEffectName}"/>
            <Label Margin="-5,5,0,0" Content="Ambient sound max distance"/>
            <TextBox Text="{Binding AmbientSoundMaxDistance, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <CheckBox Margin="0,15,0,0" IsChecked="{Binding HasAmbientSoundName}" Content="Ambient sound"/>
            <ComboBox Margin="0,5,0,0" Visibility="{c:Binding HasAmbientSoundName}" ItemsSource="{x:Static local:AppSettings.SoundDialogues}" SelectedItem="{Binding AmbientSoundName}"/>
        </StackPanel>
    </DataTemplate>
    <ControlTemplate x:Key="BulletCustomInfoFactoryViewModelTemplate" TargetType="{x:Type ContentControl}">
        <TabControl Margin="0,5,0,0">
            <TabItem Header="Properties">
                <StackPanel Margin="5">
                    <ContentPresenter/>
                    <Label Margin="-5,0,0,0" Content="Hit effect"/>
                    <ComboBox ItemsSource="{x:Static local:AppSettings.Effects}" SelectedItem="{Binding HitEffect}"/>
                    <Label Margin="-5,5,0,0" Content="Bullet effect"/>
                    <ComboBox ItemsSource="{x:Static local:AppSettings.Effects}" SelectedItem="{Binding BulletEffect}"/>
                    <Label Margin="-5,5,0,0" Content="Damage hit points"/>
                    <TextBox Text="{Binding DamageHitPoints, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                    <Label Margin="-5,5,0,0" Content="Decal damage size"/>
                    <ComboBox ItemsSource="{localEnums:EnumBindingSource enums:DecalDamageSize}" SelectedItem="{Binding DecalDamageSize}"/>
                    <CheckBox Margin="0,15,0,0" IsChecked="{Binding HasLifetime}" Content="Lifetime"/>
                    <TextBox Margin="0,5,0,0" Visibility="{c:Binding HasLifetime}" Text="{Binding Lifetime, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Damage">
                <ContentControl Focusable="False" Content="{Binding DamagePotentialViewModel}"/>
            </TabItem>
            <TabItem Header="Sound">
                <TabControl Margin="5">
