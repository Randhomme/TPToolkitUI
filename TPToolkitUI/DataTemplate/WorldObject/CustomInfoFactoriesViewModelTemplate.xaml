    <DataTemplate DataType="{x:Type vm:BulletCustomInfoFactoryViewModel}">
        <ContentControl Template="{StaticResource BulletCustomInfoFactoryViewModelTemplate}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrewCustomInfoFactoryViewModel}">
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Crew race"/>
            <ComboBox ItemsSource="{localEnums:EnumBindingSource globalEnums:Race}" SelectedItem="{Binding CrewRace}"/>
            <Label Margin="-5,5,0,0" Content="Point value"/>
            <TextBox Text="{Binding PointValue, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,5,0,0" Content="Crew name string ID"/>
            <ComboBox ItemsSource="{x:Static local:AppSettings.TPGameHeaderStrings}" SelectedItem="{Binding SelectedCrewNameStringIDGameHeader}"/>
            <ComboBox Margin="0,5,0,0" ItemsSource="{Binding AvailableCrewNameStringIDS}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding CrewNameStringID}"/>
            <CheckBox Margin="0,15,0,0" IsChecked="{Binding GunnerySkillActive}" Content="Gunnery skill active"/>
            <StackPanel Visibility="{c:Binding GunnerySkillActive}">
                <Label Margin="-5,0,0,0" Content="Gunnery skill ability value"/>
                <TextBox Text="{Binding GunnerySkillAbilityValue, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <CheckBox Margin="0,15,0,0" IsChecked="{Binding LeadershipSkillActive}" Content="Leadership skill active"/>
            <StackPanel Visibility="{c:Binding LeadershipSkillActive}">
                <Label Margin="-5,0,0,0" Content="Leadership skill ability value"/>
                <TextBox Text="{Binding LeadershipSkillAbilityValue, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <CheckBox Margin="0,15,0,0" IsChecked="{Binding NavigationSkillActive}" Content="Navigation skill active"/>
