            <ComboBox Margin="0,5,0,0" Visibility="{c:Binding HasWorldObjectToCreateUponDeath5}" ItemsSource="{x:Static local:AppSettings.Asteroids}" SelectedItem="{Binding WorldObjectToCreateUponDeath5}"/>
            <CheckBox Margin="0,15,0,0" IsChecked="{Binding HasWorldObjectToCreateUponDeath6}" Content="World object to create upon death 6"/>
            <ComboBox Margin="0,5,0,0" Visibility="{c:Binding HasWorldObjectToCreateUponDeath6}" ItemsSource="{x:Static local:AppSettings.Asteroids}" SelectedItem="{Binding WorldObjectToCreateUponDeath6}"/>
