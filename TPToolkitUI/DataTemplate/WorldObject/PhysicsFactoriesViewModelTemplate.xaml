<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:vm="clr-namespace:TPToolkitUI.ViewModels.WorldObject.PhysicsFactories"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type vm:DragonPhysicsViewModel}">
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Center of mass"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Margin="-5,0,0,0" Content="X"/>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding CenterOfMassX, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Margin="0,0,0,0" Content="Y"/>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding CenterOfMassY, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Margin="0,0,0,0" Content="Z"/>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding CenterOfMassZ, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
            </Grid>
            <Label Margin="-5,0,0,0" Content="Mass"/>
            <TextBox Text="{Binding Mass, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,0,0,0" Content="Max thrust"/>
            <TextBox Text="{Binding MaxThrust, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,0,0,0" Content="Max speed"/>
            <TextBox Text="{Binding MaxSpeed, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,0,0,0" Content="Rotational friction"/>
            <TextBox Text="{Binding RotationalFriction, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
            <Label Margin="-5,0,0,0" Content="Max angular acceleration"/>
            <TextBox Text="{Binding MaxAngularAcceleration, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>
    </DataTemplate>
