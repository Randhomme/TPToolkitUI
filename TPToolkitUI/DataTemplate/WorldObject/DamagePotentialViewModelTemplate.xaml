<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:vm="clr-namespace:TPToolkitUI.ViewModels.WorldObject"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type vm:DamagePotentialViewModel}">
        <TabControl Margin="5">
            <TabItem Header="Hull wood">
                <StackPanel Margin="5">
                    <Label Margin="-5,0,0,0" Content="Chance of critical damage"/>
                    <TextBox Text="{Binding ChanceOfCriticalDamageWood, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                    <Label Margin="-5,5,0,0" Content="Chance of fire"/>
                    <TextBox Text="{Binding ChanceOfFireWood, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                    <Label Margin="-5,5,0,0" Content="Initial fire strength"/>
                    <TextBox Text="{Binding InitialFireStrengthWood, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                    <Label Margin="-5,5,0,0" Content="Damage lower bound"/>
                    <TextBox Text="{Binding DamageLowerBoundWood, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                    <Label Margin="-5,5,0,0" Content="Damage upper bound"/>
                    <TextBox Text="{Binding DamageUpperBoundWood, NotifyOnValidationError=True, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
            </TabItem>
