<local:DialogWindow x:Class="TPToolkitUI.Dialogs.MsbElementNamePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPToolkitUI.Dialogs"
        mc:Ignorable="d"
        Title="MsbElementNamePicker" Height="150" Width="300">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="5">
            <Label Margin="-5,0,0,0" Content="Name"/>
            <TextBox x:Name="MsbElementNameTextBox" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Margin="5" MinWidth="85" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Cancel" Margin="5" MinWidth="85" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
