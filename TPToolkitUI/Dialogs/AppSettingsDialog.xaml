<local:DialogWindow x:Class="TPToolkitUI.Dialogs.AppSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPToolkitUI.Dialogs"
        mc:Ignorable="d"
        Title="App settings" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="TPGame directory" Margin="-5,0,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Padding="10,0,10,0" Content="Browse" Command="{Binding BrowseTPGameDirectoryCommand}"/>
                <TextBox Grid.Column="1" IsEnabled="False" Margin="10,0,0,0" Text="{Binding TPGameDirectory}" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Save" Margin="0,0,10,0" MinWidth="85" IsDefault="True" Click="SaveButton_Click" Command="{Binding SaveAppSettingsCommand}"/>
            <Button Content="Cancel" MinWidth="85" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
