<UserControl x:Class="TPToolkitUI.Views.MeshSceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TPToolkitUI.Views"
             xmlns:controls="clr-namespace:TPToolkitUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <Button MinWidth="85" Margin="5" Content="Import" Click="Button_Click"/>
            <Button MinWidth="85" Margin="5" Content="Export" Click="Button_Click_1"/>
            <Button MinWidth="85" Margin="5" Content="Clear" Click="Button_Click_2"/>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Nodes">
                <controls:CollectionEditorControl ItemsSource="{Binding Nodes}" AddCommand="{Binding AddMsbNodeCommand}"/>
            </TabItem>
            <TabItem Header="Meshes">
                <controls:CollectionEditorControl ItemsSource="{Binding Meshes}" AddCommand="{Binding AddMsbMeshCommand}"/>
            </TabItem>
            <TabItem Header="Bones">
                <controls:CollectionEditorControl ItemsSource="{Binding Bones}" AddCommand="{Binding AddMsbBoneCommand}"/>
            </TabItem>
            <TabItem Header="Animations">
                <controls:CollectionEditorControl ItemsSource="{Binding Animations}" AddCommand="{Binding AddMsbAnimationCommand}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
