<UserControl x:Class="TPToolkitUI.Views.MeshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TPToolkitUI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="MDB to 3D file" Margin="5,5,3.5,5">
            <StackPanel Margin="0">
                <Button Margin="5" Content="X MDB to 1 3D file" Click="Button_Click"/>
                <Button Margin="5" Content="X MDB to X 3D file" Click="Button_Click_1"/>
                <CheckBox Margin="5" Content="Export lods" IsChecked="{Binding ExportLods}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="3D file to MDB" Grid.Column="1" Margin="3.5,5,5,5">
            <StackPanel>
                <Button Margin="5" Content="X 3D file to X MDB" Click="Button_Click_2"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
